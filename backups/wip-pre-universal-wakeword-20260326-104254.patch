+  String _sanitizeComposePrompt(String prompt) {
+    if (!_composeSession.active) return prompt;
+    var cleaned = prompt;
+    final patterns = <RegExp>[
+      RegExp(
+        r"\bconsider the user's current location, people present, personal interests, and the time of year\b\.??",
+        caseSensitive: false,
+      ),
+      RegExp(
